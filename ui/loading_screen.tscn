[node name="StatusLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.87, 0.9, 0.95, 1)
theme_override_font_sizes/font_size = 18
text = "Loading course assets..."
