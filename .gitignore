# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg
export_credentials.cfg

# Imported translations
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
.claude

# IDE Specific, used for code analytics outside of Godot IDE. 
.vscode

*addons/terrain_3d/bin/*

gut_temp/
